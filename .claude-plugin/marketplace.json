{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "suite",
  "description": "Personal plugins for Claude Code, Codex, and Cursor, plus curated external ones",
  "owner": {
    "name": "slow42"
  },
  "plugins": [
    {
      "name": "suite-sync",
      "source": "./plugins/suite-sync",
      "description": "Enables every suite plugin at user scope and keeps the suite marketplace on autoUpdate"
    },
    {
      "name": "context-analysis",
      "source": "./plugins/context-analysis"
    },
    {
      "name": "stale-session-guard",
      "source": "./plugins/stale-session-guard"
    },
    {
      "name": "git-protect",
      "source": "./plugins/git-protect"
    },
    {
      "name": "worktree-shortcut",
      "source": "./plugins/worktree-shortcut"
    },
    {
      "name": "suite-dev",
      "source": "./plugins/suite-dev",
      "description": "Add new plugins and skills to this marketplace"
    },
    {
      "name": "code-review",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "plugins/code-review",
        "ref": "main"
      }
    },
    {
      "name": "project-memory",
      "source": "./plugins/project-memory"
    },
    {
      "name": "mattpocock-skills",
      "source": {
        "source": "url",
        "url": "https://github.com/mattpocock/skills.git"
      }
    }
  ]
}
